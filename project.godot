; Engine configuration file.
; Edit through the Godot editor where practical.

config_version=5

[application]

config/name="RPG 2D"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene="res://scenes/prototypes/player_movement_test.tscn"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
interaction_menu_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
interaction_menu_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
interaction_confirm={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RPG2D"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
